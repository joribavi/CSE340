<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <form action="/assign-categories/<%= projectId %>" method="POST">
        <div class="form-group checkbox-section">
            <!-- Título de la sección -->
            <span class="section-title">Select Categories</span>

            <!-- Lista de categorías -->
            <% categories.forEach(category => { %>
                <div class="checkbox-group">
                    <input 
                        type="checkbox" 
                        id="category-<%= category.category_id %>" 
                        name="categoryIds" 
                        value="<%= category.category_id %>"
                    >
                    <label for="category-<%= category.category_id %>">
                        <%= category.category_name %>
                    </label>
                </div>
            <% }) %>
        </div>

        <button type="submit">Update Categories</button>
    </form>
</main>
<%- include('partials/footer') %>
