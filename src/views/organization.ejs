
   <%- include('partials/header') %>

  <main>
     <h1><%= title %></h1>
      <section>
        <img src="/images/<%= organizationDetails.logo_filename %>" 
             alt="<%= organizationDetails.name %> logo">
        <h2><%= organizationDetails.name %></h2>
        <p><%= organizationDetails.description %></p>
        <p>Contact: <%= organizationDetails.contact_email %></p>
      <p> <a href="/edit-organization/<%= organizationDetails.organization_id %>">Edit Organization</a></p> 
      </section>

    <h3>Projects</h3>
    <ul>
        <% projects.forEach(project => { %>
            <li>
                <strong><%= project.project_title %></strong> - 
                <%= project.description %> 
                (<%= project.location %>, <%= project.project_date %>)
            </li>
        <% }); %>
    </ul>
    </main>

    <%- include('partials/footer') %>
