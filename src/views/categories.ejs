<%- include('partials/header') %>

    <main>
        <h1><%= title %></h1>
          <ul style="list-style: none">  
            <% categories.forEach(category => { %>
                <li>
                  <a href="/categories/<%= category.id %>"><%= category.category_id %></a>
                  <%= category.category_name %>
                </li>
            <% }); %>
          </ul>  
    </main>

