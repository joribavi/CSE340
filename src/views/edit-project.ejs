<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <form action="/edit-project/<%= project.project_id %>" method="POST">
      <div class="form-group">
      <label for="title">Project Name</label>
     <textarea required
      id="title"
      name="title"
       maxlength="150"><%= project.project_title %></textarea>
    </div>

  <div class="form-group">
     <label for="description">Project Description</label>
     <textarea required
       id="description"
      name="description"
      maxlength="500"><%= project.description %></textarea>
   </div>
   <div class="form-group">
        <label for="location">Location</label>
        <textarea required
          type="text"
          id="location"
          name="location"
          maxlength="150"
       > <%= project.location %></textarea>
     
    </div>
    <div class="form-group">
        <label for="date">Date</label>
        <input
          type="date"
          id="date"
          name="date"
          value="<%= project.date %>"
          required
        />
    </div>
   <div class="form-group">
     <label for="organization_id">Organization</label>
     <select id="organization_id" name="organization_id" required>
      <% organizations.forEach(org => { %>
      <option value="<%= org.organization_id %>" <%= org.organization_id === project.organization_id ? 'selected' : '' %>>
        <%= org.name %>
      </option>
    <% }); %>
  </select>
</div>

         <button type="submit">Update Organization</button>
        </form>   


</main>
<%- include('partials/footer') %>