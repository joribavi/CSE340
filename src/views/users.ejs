<%- include('partials/header') %>

  <main class="users-page">
  <h1><%= title %></h1>
  <ul class="user-list">  
    <% users.forEach(user => { %>
      <li class="user-card">
        <p><strong>User:</strong> <%= user.name %></p>
        <p><strong>Email:</strong> <%= user.email %></p>
        <p><strong>Role:</strong> <%= user.role %></p>
      </li>
    <% }); %>
  </ul>
</main>

<%- include('partials/footer') %>