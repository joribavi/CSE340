 <%- include('partials/header') %>
    <main>
       <h1><%= project.project_title %></h1>
       <h2>Project Information</h2>
       <p><%= project.description %></p>
        <h2>Project Location</h2>
       <p><%= project.location %></p>
        <h2>Project Date</h2>
       <p><%= project.project_date %></p>

       <h2>Categories</h2>
       <% if (categories.length > 0) { %>
        <ul style="list-style: none"> 
       <% categories.forEach(category => { %>
        <li>
          <a href="/categories/<%= category.category_id %>"><%= category.category_name %></a>
        </li>
       <% }); %>
       </ul>
       <% } else { %>
      <p>No categories assigned to this project.</p>
      <% } %> 

       <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>

       <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p> 

 <%- include('partials/footer') %>