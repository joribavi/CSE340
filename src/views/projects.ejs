
    <%- include('partials/header') %>

    <main>
        <h1><%= title %></h1>
        <h2>Upcoming Service Projects</h2>
      
           <% projects.forEach(project => { %>
           
          <h3 style="margin: 5px 0;"><strong><%= project.project_title %> </strong></h3>  
              <ul style="list-style: none">  
                <li style="font-weight: bold; color: #522312"><%= project.organization_name %></li> 
                <li><%= project.description %></li>    
                <li><%= project.location %></li> 
                <li><%= project.project_date %></li> 
              </ul>  
            <% }); %>
      
       
      </main>

      <%- include('partials/footer') %>